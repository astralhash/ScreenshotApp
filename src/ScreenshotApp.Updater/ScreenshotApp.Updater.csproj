<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Installs a downloaded ScreenshotApp release over the running copy (see Program.cs).
    Published with NativeAOT into one small exe with no runtime dependency, and shipped inside the release zip.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyName>ScreenshotApp.Updater</AssemblyName>
    <RootNamespace>ScreenshotApp.Updater</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <ApplicationIcon>..\ScreenshotApp\app.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
