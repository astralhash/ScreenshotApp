<Window
    x:Class="ScreenshotApp.Preferences.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenshotApp.Preferences">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid PreviewKeyDown="Root_PreviewKeyDown" KeyUp="Root_KeyUp">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,12,0,0" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0">
            <TextBlock Text="Settings" VerticalAlignment="Center" Margin="14,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,4,24,28" Spacing="8" MaxWidth="680">

                <!-- What a capture does -->
                <TextBlock Text="When a screenshot is taken" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <CheckBox Content="Open it in the editor" IsChecked="{x:Bind ViewModel.TargetEditor, Mode=TwoWay}" />
                        <CheckBox Content="Copy it to the clipboard" IsChecked="{x:Bind ViewModel.TargetClipboard, Mode=TwoWay}" />
                        <CheckBox Content="Save it to the folder below" IsChecked="{x:Bind ViewModel.TargetFile, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Visibility="{x:Bind ViewModel.NoTargets, Mode=OneWay}"
                                   Text="Nothing is selected, so a capture would go nowhere." />
                    </StackPanel>
                </Border>

                <!-- Saving -->
                <TextBlock Text="Saving" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Default save folder" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.SaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="File name pattern" />
                            <TextBox Text="{x:Bind ViewModel.FilenamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{x:Bind ViewModel.FilenamePreview, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="yyyy year, MM month, dd day, HH hour, mm minute, ss second. Other text is kept as written." />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Image format" />
                            <ComboBox SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}" MinWidth="160">
                                <ComboBoxItem Content="PNG (lossless)" />
                                <ComboBoxItem Content="JPEG (smaller files)" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hotkeys: click a key box, then press the new combination -->
                <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Hotkeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:HotkeyRow">
                                    <Grid ColumnSpacing="8" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Tag="{x:Bind}"
                                                Content="{x:Bind Text, Mode=OneWay}" Click="Hotkey_Click" LostFocus="Hotkey_LostFocus" />
                                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                ToolTipService.ToolTip="Clear" Tag="{x:Bind}" Click="HotkeyClear_Click"
                                                IsEnabled="{x:Bind CanClear, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Visibility="{x:Bind ViewModel.HasHotkeyMessage, Mode=OneWay}"
                                   Text="{x:Bind ViewModel.HotkeyMessage, Mode=OneWay}" />
                        <Button Content="Reset hotkeys to defaults" Click="HotkeyReset_Click" />
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Text="Tip: press Z during a region capture to toggle a zoom lens for pixel-precise selection." />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Arrow keys or W A S D move the cursor one pixel. With the zoom lens on, C copies the color under the cursor (#RRGGBB). Esc cancels." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Capture settings -->
                <TextBlock Text="Capture settings" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <ToggleSwitch Header="Hide the editor while taking a new capture" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.DuckEditorForCapture, Mode=TwoWay}" />
                        <ToggleSwitch Header="Include the mouse cursor in captures" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CaptureCursor, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <ToggleSwitch Header="Launch at Windows startup" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}" />
                        <ToggleSwitch Header="Ask before removing all clips" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.ConfirmRemoveAll, Mode=TwoWay}" />
                        <ToggleSwitch Header="Close the editor when the last clip is closed" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.CloseEditorWhenEmpty, Mode=TwoWay}" />
                        <StackPanel Spacing="4">
                            <ToggleSwitch Header="Enable experimental features" OnContent="On" OffContent="Off"
                                          IsOn="{x:Bind ViewModel.ExperimentalFeatures, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Adds &quot;Share Region…&quot; to the tray menu: shows a screen region as a hidden window that Teams and other apps can share." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About -->
                <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ScreenshotApp" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Bind ViewModel.VersionText}" IsTextSelectionEnabled="True" />
                        <HyperlinkButton Content="github.com/astralhash/ScreenshotApp" Margin="-12,4,0,0"
                                         NavigateUri="https://github.com/astralhash/ScreenshotApp" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
