<Window
    x:Class="ScreenshotApp.Preferences.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,12,0,0" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="KeyCap" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0">
            <TextBlock Text="Settings" VerticalAlignment="Center" Margin="14,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,4,24,28" Spacing="8" MaxWidth="680">

                <!-- What a capture does -->
                <TextBlock Text="When a screenshot is taken" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <CheckBox Content="Open it in the editor" IsChecked="{x:Bind ViewModel.TargetEditor, Mode=TwoWay}" />
                        <CheckBox Content="Copy it to the clipboard" IsChecked="{x:Bind ViewModel.TargetClipboard, Mode=TwoWay}" />
                        <CheckBox Content="Save it to the folder below" IsChecked="{x:Bind ViewModel.TargetFile, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Visibility="{x:Bind ViewModel.NoTargets, Mode=OneWay}"
                                   Text="Nothing is selected, so a capture would go nowhere." />
                    </StackPanel>
                </Border>

                <!-- Saving -->
                <TextBlock Text="Saving" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Default save folder" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.SaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="File name pattern" />
                            <TextBox Text="{x:Bind ViewModel.FilenamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{x:Bind ViewModel.FilenamePreview, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="yyyy year, MM month, dd day, HH hour, mm minute, ss second. Other text is kept as written." />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Image format" />
                            <ComboBox SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}" MinWidth="160">
                                <ComboBoxItem Content="PNG (lossless)" />
                                <ComboBoxItem Content="JPEG (smaller files)" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hotkeys: display only for now -->
                <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <Grid RowSpacing="10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Full screen (monitor under the cursor)" VerticalAlignment="Center" />
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + Shift + 1" /></Border>
                        <TextBlock Grid.Row="1" Text="Window" VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + Shift + 2" /></Border>
                        <TextBlock Grid.Row="2" Text="Region" VerticalAlignment="Center" />
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + Shift + 3" /></Border>
                        <TextBlock Grid.Row="3" Text="Region (alternative)" VerticalAlignment="Center" />
                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource KeyCap}"><TextBlock Text="Print Screen" /></Border>
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                                   Text="Changing hotkeys is not available yet. During a region capture: Z toggles the zoom lens, arrow keys move the cursor one pixel, Esc cancels." />
                    </Grid>
                </Border>

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <ToggleSwitch Header="Launch at Windows startup" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}" />
                        <ToggleSwitch Header="Copy the current clip to the clipboard when the editor is closed" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.AutoCopyOnClose, Mode=TwoWay}" />
                        <ToggleSwitch Header="Ask before removing all clips" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.ConfirmRemoveAll, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
