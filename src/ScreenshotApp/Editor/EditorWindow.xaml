<Window
    x:Class="ScreenshotApp.Editor.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenshotApp.Editor"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
          PreviewKeyDown="Root_PreviewKeyDown" KeyUp="Root_KeyUp">
        <Grid.Resources>
            <!-- Toolbar buttons never take focus, so Space always reaches the pan handler. -->
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="ToolIcon" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region). Caption buttons are drawn by the system on the right. -->
        <Grid x:Name="TitleBar" Grid.Row="0">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" VerticalAlignment="Center" Margin="14,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Command bar -->
        <Grid Grid.Row="1" Padding="8,4,8,6" ColumnSpacing="4" Visibility="{x:Bind ViewModel.HasShots, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.CopyCommand}"
                        ToolTipService.ToolTip="Copy (Ctrl+C)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.SaveCommand}"
                        ToolTipService.ToolTip="Save (Ctrl+S)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.SaveAsCommand}"
                        ToolTipService.ToolTip="Save As (Ctrl+Shift+S)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE792;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Save As" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource ToolButton}" Click="ZoomOut_Click" ToolTipService.ToolTip="Zoom out (Ctrl+wheel)">
                    <FontIcon Glyph="&#xE71F;" Style="{StaticResource ToolIcon}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Zoom100_Click" MinWidth="64"
                        ToolTipService.ToolTip="Actual size (Ctrl+1)">
                    <TextBlock Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoom in (Ctrl+wheel)">
                    <FontIcon Glyph="&#xE8A3;" Style="{StaticResource ToolIcon}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" Style="{StaticResource ToolIcon}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Fit_Click" ToolTipService.ToolTip="Fit to window (Ctrl+0)">
                    <FontIcon Glyph="&#xE9A6;" Style="{StaticResource ToolIcon}" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number0" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tools -->
        <Grid Grid.Row="2" Padding="8,0,8,4" Visibility="{x:Bind ViewModel.HasShots, Mode=OneWay}">
            <StackPanel x:Name="ToolPanel" Orientation="Horizontal" Spacing="2">
                <ToggleButton Tag="Select" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Select / Move (V)">
                    <PathIcon Data="M3,2 L3,13.5 L6.3,10.4 L8.6,15 L10.4,14.2 L8.1,9.6 L12.4,9.2 Z" />
                </ToggleButton>
                <ToggleButton Tag="Arrow" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Arrow (A)">
                    <PathIcon Data="M2.2,12.8 L10,5 L11,6 L3.2,13.8 Z M8,2.5 L13.5,2.5 L13.5,8 Z" />
                </ToggleButton>
                <ToggleButton Tag="Rectangle" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Rectangle (R)">
                    <PathIcon Data="F0 M2,3 L14,3 L14,13 L2,13 Z M3.5,4.5 L3.5,11.5 L12.5,11.5 L12.5,4.5 Z" />
                </ToggleButton>
                <ToggleButton Tag="Line" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Line (L)">
                    <PathIcon Data="M2.2,12.8 L12.8,2.2 L13.8,3.2 L3.2,13.8 Z" />
                </ToggleButton>
                <ToggleButton Tag="Pen" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Pen (P)">
                    <FontIcon Glyph="&#xE70F;" Style="{StaticResource ToolIcon}" />
                </ToggleButton>
                <ToggleButton Tag="Highlighter" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Highlighter (H)">
                    <FontIcon Glyph="&#xE7E6;" Style="{StaticResource ToolIcon}" />
                </ToggleButton>
                <ToggleButton Tag="Text" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Text (T)">
                    <TextBlock Text="T" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                </ToggleButton>
                <ToggleButton Tag="Step" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Numbered step (N)">
                    <Border Width="19" Height="19" CornerRadius="10" BorderThickness="1.5"
                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}">
                        <TextBlock Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ToggleButton>
                <ToggleButton Tag="Blur" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Blur / pixelate (B)">
                    <PathIcon Data="M2,2 L6,2 L6,6 L2,6 Z M10,2 L14,2 L14,6 L10,6 Z M6,6 L10,6 L10,10 L6,10 Z M2,10 L6,10 L6,14 L2,14 Z M10,10 L14,10 L14,14 L10,14 Z" />
                </ToggleButton>
                <ToggleButton Tag="Crop" Style="{StaticResource ToolToggle}" Click="Tool_Click" ToolTipService.ToolTip="Crop (C)">
                    <FontIcon Glyph="&#xE7A8;" Style="{StaticResource ToolIcon}" />
                </ToggleButton>                <Rectangle Width="1" Margin="8,6" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" Style="{StaticResource ToolIcon}" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Redo (Ctrl+Shift+Z)">
                    <FontIcon Glyph="&#xE7A6;" Style="{StaticResource ToolIcon}" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{x:Bind ViewModel.CleanCommand}"
                        ToolTipService.ToolTip="Clean: remove all edits and restore the original capture (undoable)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE777;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Clean" />
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <!-- Properties: depend on the active tool -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="14" Padding="14,2,8,8" MinHeight="40"
                    Visibility="{x:Bind ViewModel.HasShots, Mode=OneWay}">
            <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ShowColor, Mode=OneWay}">
                <Button x:Name="CustomColorButton" Width="24" Height="24" Padding="0" CornerRadius="12"
                        AllowFocusOnInteraction="False" ToolTipService.ToolTip="Custom color">
                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                    <Button.Flyout>
                        <Flyout>
                            <ColorPicker x:Name="CustomPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                         ColorChanged="CustomPicker_ColorChanged" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ShowWidth, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.WidthLabel, Mode=OneWay}" MinWidth="48" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Slider Width="140" Minimum="1" Maximum="40" StepFrequency="1" VerticalAlignment="Center"
                        Value="{x:Bind ViewModel.StrokeWidth, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind ViewModel.StrokeWidth, Mode=OneWay}" MinWidth="18" VerticalAlignment="Center" />
            </StackPanel>
            <ToggleButton Style="{StaticResource ToolToggle}" Width="Auto" Padding="10,0" VerticalAlignment="Center"
                          Visibility="{x:Bind ViewModel.ShowFill, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.FillShapes, Mode=TwoWay}" ToolTipService.ToolTip="Fill shapes">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M2,3 L14,3 L14,13 L2,13 Z" />
                    <TextBlock Text="Fill" />
                </StackPanel>
            </ToggleButton>
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ShowBlurMode, Mode=OneWay}">
                <ToggleButton x:Name="PixelateToggle" Content="Pixelate" Style="{StaticResource ToolToggle}" Width="Auto" Padding="12,0"
                              IsChecked="{x:Bind ViewModel.IsPixelate, Mode=OneWay}" Click="PixelateMode_Click" />
                <ToggleButton x:Name="BlurToggle" Content="Blur" Style="{StaticResource ToolToggle}" Width="Auto" Padding="12,0"
                              IsChecked="{x:Bind ViewModel.IsBlur, Mode=OneWay}" Click="BlurMode_Click" />
                <ToggleButton x:Name="SolidToggle" Content="Solid" Style="{StaticResource ToolToggle}" Width="Auto" Padding="12,0"
                              IsChecked="{x:Bind ViewModel.IsSolid, Mode=OneWay}" Click="SolidMode_Click"
                              ToolTipService.ToolTip="Opaque fill: the only mode that cannot be reversed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsCropTool, Mode=OneWay}">
                <Button Content="Apply crop" Style="{StaticResource AccentButtonStyle}" AllowFocusOnInteraction="False"
                        Command="{x:Bind ViewModel.ApplyCropCommand}" ToolTipService.ToolTip="Apply crop (Enter)" />
                <Button Content="Cancel" AllowFocusOnInteraction="False"
                        Command="{x:Bind ViewModel.CancelCropCommand}" ToolTipService.ToolTip="Cancel (Esc)" />
                <TextBlock Text="Drag the handles, or drag on the image to pick a new area" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
        <!-- Canvas area -->
        <local:CursorGrid x:Name="Host" Grid.Row="4" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                          PointerPressed="Host_PointerPressed" PointerMoved="Host_PointerMoved"
                          PointerReleased="Host_PointerReleased" PointerCanceled="Host_PointerReleased"
                          PointerWheelChanged="Host_PointerWheelChanged" SizeChanged="Host_SizeChanged"
                          DoubleTapped="Host_DoubleTapped">
            <canvas:CanvasControl x:Name="Canvas" ClearColor="Transparent"
                                  CreateResources="Canvas_CreateResources" Draw="Canvas_Draw" />
            <!-- In-place text editor, positioned over the annotation being edited -->
            <TextBox x:Name="TextEditor" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                     AcceptsReturn="True" TextWrapping="NoWrap" MinWidth="48" Padding="0" BorderThickness="1"
                     Background="Transparent" FontFamily="Segoe UI"
                     BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                     PreviewKeyDown="TextEditor_PreviewKeyDown" LostFocus="TextEditor_LostFocus" />
        </local:CursorGrid>

        <!-- Film strip: newest shot on the left -->
        <Border Grid.Row="5" Visibility="{x:Bind ViewModel.HasShots, Mode=OneWay}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <ListView x:Name="FilmStrip" Height="122" Padding="8,6" SelectionMode="Single"
                      ItemsSource="{x:Bind ViewModel.Shots}" SelectedItem="{x:Bind ViewModel.SelectedShot, Mode=TwoWay}"
                      AllowFocusOnInteraction="False"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      PointerWheelChanged="FilmStrip_PointerWheelChanged">
                <ListView.Resources>
                    <!-- Hide the built-in left selection pill; the active clip is marked under its thumbnail instead. -->
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:EditorDocument">
                        <StackPanel Spacing="4">
                            <Grid Width="160" Height="90" CornerRadius="4" Background="Transparent"
                                  Tag="{x:Bind}" ContextRequested="Thumb_ContextRequested"
                                  PointerEntered="Thumb_PointerEntered" PointerExited="Thumb_PointerExited">
                                <Image Source="{x:Bind Thumbnail}" Stretch="Uniform" />
                                <Button Tag="{x:Bind}" Click="RemoveShot_Click" Visibility="Collapsed"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                        Width="22" Height="22" Padding="0" CornerRadius="11"
                                        AllowFocusOnInteraction="False" ToolTipService.ToolTip="Remove from film strip">
                                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                                </Button>
                            </Grid>
                            <!-- Active clip marker, under the thumbnail -->
                            <Border Height="3" Width="160" CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Start page: shown while there are no clips -->
        <StackPanel Grid.Row="1" Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="18" MaxWidth="560" Padding="24"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="48" HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="No clips yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Capture something, open an image file, or drop a PNG or JPEG here."
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Equal-sized tiles on one grid: Open file across the top, the three capture modes below -->
            <Grid Width="420" ColumnSpacing="10" RowSpacing="10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.ColumnSpan="3" Style="{StaticResource AccentButtonStyle}" Click="OpenFile_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="44"
                        AllowFocusOnInteraction="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                        <TextBlock Text="Open file…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="2" Tag="Region" Click="CaptureButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="84"
                        AllowFocusOnInteraction="False" ToolTipService.ToolTip="Ctrl+Shift+3 or Print Screen">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <PathIcon Data="M2,2 L6,2 L6,3.2 L3.2,3.2 L3.2,6 L2,6 Z M10,2 L14,2 L14,6 L12.8,6 L12.8,3.2 L10,3.2 Z M2,10 L3.2,10 L3.2,12.8 L6,12.8 L6,14 L2,14 Z M14,10 L14,14 L10,14 L10,12.8 L12.8,12.8 L12.8,10 Z" />
                        <TextBlock Text="Region" HorizontalAlignment="Center" />
                        <TextBlock Text="Ctrl+Shift+3" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Tag="Window" Click="CaptureButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="84"
                        AllowFocusOnInteraction="False" ToolTipService.ToolTip="Ctrl+Shift+2">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <PathIcon Data="F0 M2,3 L14,3 L14,13 L2,13 Z M3.2,6 L3.2,11.8 L12.8,11.8 L12.8,6 Z" />
                        <TextBlock Text="Window" HorizontalAlignment="Center" />
                        <TextBlock Text="Ctrl+Shift+2" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Tag="FullScreen" Click="CaptureButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="84"
                        AllowFocusOnInteraction="False" ToolTipService.ToolTip="Ctrl+Shift+1">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                        <TextBlock Text="Full screen" HorizontalAlignment="Center" />
                        <TextBlock Text="Ctrl+Shift+1" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
            <HyperlinkButton Click="Settings_Click" HorizontalAlignment="Center" Content="Settings" />
        </StackPanel>
    </Grid>
</Window>
