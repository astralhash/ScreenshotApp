<Window
    x:Class="ScreenshotApp.Updates.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0">
            <TextBlock Text="Update available" VerticalAlignment="Center" Margin="14,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Version summary -->
        <StackPanel Grid.Row="1" Padding="24,8,24,12" Spacing="4">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="DetailText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Release notes of every newer release -->
        <Border Grid.Row="2" Margin="24,0,24,0" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer Padding="16,14,16,10">
                <RichTextBlock x:Name="NotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,8,0" />
            </ScrollViewer>
        </Border>

        <!-- Status, progress and buttons -->
        <StackPanel Grid.Row="3" Padding="24,12,24,20" Spacing="10">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Visibility="Collapsed"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressBar x:Name="Progress" Maximum="1" Visibility="Collapsed" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton x:Name="PageLink" Content="View on GitHub" Margin="-12,0,0,0" Click="PageLink_Click" />
                <Button x:Name="SkipButton" Grid.Column="1" Content="Skip this version" Click="Skip_Click" />
                <Button x:Name="LaterButton" Grid.Column="2" Content="Later" Click="Later_Click" />
                <Button x:Name="UpdateButton" Grid.Column="3" Content="Update now" Style="{StaticResource AccentButtonStyle}"
                        Click="Update_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
